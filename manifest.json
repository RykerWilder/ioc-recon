{
  "manifest_version": 3,
  "name": "IOC Recon",
  "version": "2.1.0",
  "description": "Quick analysis of selected IOCs (IPs, URLs, domains) with AbuseIPDB and Proxycheck.io, with a toolbar history of your last lookups",
  "permissions": [
    "contextMenus",
    "scripting",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.abuseipdb.com/*",
    "https://proxycheck.io/*",
    "https://dns.google/*"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "ioc-recon-selection": {
      "suggested_key": {
        "default": "Alt+R",
        "mac": "Alt+R"
      },
      "description": "IOC recon of the selected text"
    }
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "IOC Recon"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  }
}
